{
  "name": "zap-books",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:cloud": "vite --host 0.0.0.0",
    "build": "npm run wasm:build && tsc -b && vite build",
    "build:demo": "npm run wasm:build && tsc -b && VITE_DEMO_ONLY=true vite build --base /demo/ --outDir dist-demo",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloud": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test --config playwright.remote.config.ts",
    "test:e2e:site": "playwright test --config playwright.site.config.ts",
    "wasm:build": "node scripts/build-wasm.mjs",
    "site:build": "node scripts/build-pages.mjs",
    "site:serve": "node scripts/serve-static.mjs dist-pages 4180",
    "test:wasm": "npm run wasm:build && vitest run --config scripts/vitest.wasm.config.mjs",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "node scripts/hooks/install.mjs",
    "parity:fixtures": "TZ=America/New_York vitest run --config scripts/vitest.parity.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "nostr-tools": "2.25.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
